model productCategory {
  id                       Int               @id @default(autoincrement())
  categoryName             String            @db.VarChar(100)
  parentCategoryId         Int?
  parentCategory           productCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories            productCategory[] @relation("CategoryHierarchy")
  description              String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime?          @updatedAt
  deletedAt                DateTime?
  createdBy                String
  productCategoryCreatedBy user              @relation("productCategoryCreatedBy", fields: [createdBy], references: [id])
  updatedBy                String?
  productCategoryUpdatedBy user?              @relation("productCategoryUpdatedBy", fields: [updatedBy], references: [id])
  products                 product[]
}

model product {
  id                    Int                     @id @default(autoincrement())
  productName           String                  @db.VarChar(200)
  description           String?
  sku                   String                  @unique @db.VarChar(50)
  barcode               String?                 @unique @db.VarChar(50)
  currentStock          Decimal                 @default(0) @db.Decimal(20, 4)
  minStock              Decimal                 @default(0) @db.Decimal(20, 4)
  unitId                Int?
  unit                  unit?                   @relation("productUnit", fields: [unitId], references: [id])
  unitLabel             String?                 @db.VarChar(20)
  productCategoryId     Int?
  parentProductId       Int?
  parentProduct         product?                @relation("ProductHierarchy", fields: [parentProductId], references: [id])
  subProducts           product[]               @relation("ProductHierarchy")
  isTradeable           Boolean                 @default(true)
  isLowStockAlertEnabled Boolean                @default(true)
  hasFormula            Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime?                @updatedAt
  deletedAt             DateTime?
  createdBy             String
  productCreatedBy      user                    @relation("productCreatedBy", fields: [createdBy], references: [id])
  updatedBy             String?
  productUpdatedBy      user?                    @relation("productUpdatedBy", fields: [updatedBy], references: [id])
  category              productCategory?        @relation(fields: [productCategoryId], references: [id])
  productInventory      productInventory[]
  productWastes         productWaste[]
  productPrice          productPrice[]
  productImages         productImage[]
  productAttributeValue productAttributeValue[]
  rfqProducts           rfqProduct[]            @relation("rfqProduct")
  requestProducts       requestProduct[]        @relation("requestProduct")
  purchaseOrderProducts purchaseOrderProduct[]  @relation("purchaseOrderProduct")
  item                  item[]                  @relation("itemProduct")
  salesOrderItems       salesOrderItem[]        @relation("salesOrderProduct")
  vendorProducts        vendorProduct[]         @relation("productVendorProduct")
  recipes               productRecipe[]         @relation("parentProductRecipe")
  usedInRecipes         productRecipe[]         @relation("ingredientProductRecipe")
  productionBatches     productionBatch[]       @relation("productProductionBatch")
  consumedInBatches     productionBatchItem[]   @relation("ingredientProductionBatchItem")
  storageStocks         productStorageStock[]
  facilityProducts      facilityProduct[]
}

model productAttribute {
  id                      Int                     @id @default(autoincrement())
  name                    String                  @db.VarChar(100)
  description             String?
  type                    String                  @db.VarChar(50) // text, number, select, multi_select
  options                 String?                 @db.Text // JSON array for select/multi_select
  createdAt               DateTime                @default(now())
  updatedAt               DateTime?                @updatedAt
  deletedAt               DateTime?
  productAttributeValues  productAttributeValue[]
  createdBy               String
  updatedBy               String?
  productAttributeCreated user                    @relation("productAttributeCreatedBy", fields: [createdBy], references: [id])
  productAttributeUpdated user?                    @relation("productAttributeUpdatedBy", fields: [updatedBy], references: [id])
}

model productAttributeValue {
  id                             Int              @id @default(autoincrement())
  productId                      Int
  attributeId                    Int
  value                          String           @db.Text
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime?         @updatedAt
  deletedAt                      DateTime?
  product                        product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute                      productAttribute @relation(fields: [attributeId], references: [id])
  createdBy                      String
  updatedBy                      String?
  productAttributeValueCreatedBy user             @relation("productAttributeValueCreatedBy", fields: [createdBy], references: [id])
  productAttributeValueUpdatedBy user?             @relation("productAttributeValueUpdatedBy", fields: [updatedBy], references: [id])
}

model productPrice {
  id                    Int       @id @default(autoincrement())
  productId             Int
  customerGroup        Int?      // Optional customer group tier (1: Regular, 2: VIP, 3: Wholesale/B2B, 4: Corporate, 5: Distributor, null: General / Base)
  amount                Decimal   @db.Decimal(12, 2)
  priceType             String    @db.VarChar(50) // retail, wholesale, special
  startDate             DateTime  @default(now())
  endDate               DateTime?
  currency              String    @default("IDR") @db.VarChar(3)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime?  @updatedAt
  deletedAt             DateTime?
  createdBy             String
  updatedBy             String?
  productPriceCreatedBy user      @relation("productPriceCreatedBy", fields: [createdBy], references: [id])
  productPriceUpdatedBy user?      @relation("productPriceUpdatedBy", fields: [updatedBy], references: [id])
  product               product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model productImage {
  id                    Int       @id @default(autoincrement())
  productId             Int
  imageUrl              String    @db.VarChar(500)
  altText               String?
  isPrimary             Boolean   @default(false)
  sortOrder             Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime?  @updatedAt
  deletedAt             DateTime?
  createdBy             String
  updatedBy             String?
  productImageCreatedBy user      @relation("productImageCreatedBy", fields: [createdBy], references: [id])
  productImageUpdatedBy user?      @relation("productImageUpdatedBy", fields: [updatedBy], references: [id])

  product product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model productInventory {
  id                      Int       @id @default(autoincrement())
  productId               Int
  transactionType         inventoryTransactionType
  quantity                Decimal   @db.Decimal(20, 4)
  reference               String?   @db.VarChar(100) // Order ID, Invoice ID, etc.
  notes                   String?
  transactionDate         DateTime  @default(now())
  currentStock            Decimal   @db.Decimal(20, 4) // Stock after this transaction
  facilityId              Int?
  sectionId               Int?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime?  @updatedAt
  deletedAt               DateTime?
  createdBy               String
  updatedBy               String?
  product                 product   @relation(fields: [productId], references: [id])
  facility                facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  section                 facilitySection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  productInventoryCreated user      @relation("productInventoryCreatedBy", fields: [createdBy], references: [id])
  productInventoryUpdated user?      @relation("productInventoryUpdatedBy", fields: [updatedBy], references: [id])

  @@index([facilityId])
  @@index([sectionId])
}

model vendorProduct {
  id                      Int       @id @default(autoincrement())
  vendorId                Int
  productId               Int
  vendorSku               String?   @db.VarChar(100)
  vendorPrice             Decimal?  @db.Decimal(12, 2)
  currency                String    @default("IDR") @db.VarChar(3)
  leadTimeDays            Int?
  minOrderQuantity        Int?
  isPreferred             Boolean   @default(false)
  notes                   String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime? @updatedAt
  deletedAt               DateTime?
  createdBy               String
  updatedBy               String?
  vendorProductCreatedBy  user      @relation("vendorProductCreatedBy", fields: [createdBy], references: [id])
  vendorProductUpdatedBy  user?     @relation("vendorProductUpdatedBy", fields: [updatedBy], references: [id])
  vendor                  vendor    @relation("vendorVendorProduct", fields: [vendorId], references: [id], onDelete: Cascade)
  product                 product   @relation("productVendorProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([vendorId, productId])
  @@index([vendorId])
  @@index([productId])
}

model productRecipe {
  id                    Int       @id @default(autoincrement())
  productId             Int
  ingredientProductId   Int
  quantity              Decimal   @db.Decimal(20, 4)
  unitId                Int?
  unitLabel             String?   @db.VarChar(20)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt
  deletedAt             DateTime?
  createdBy             String
  updatedBy             String?

  product               product   @relation("parentProductRecipe", fields: [productId], references: [id], onDelete: Cascade)
  ingredient            product   @relation("ingredientProductRecipe", fields: [ingredientProductId], references: [id])
  unit                  unit?     @relation("recipeUnit", fields: [unitId], references: [id])
  productRecipeCreatedBy user     @relation("productRecipeCreatedBy", fields: [createdBy], references: [id])
  productRecipeUpdatedBy user?    @relation("productRecipeUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([productId, ingredientProductId])
  @@index([productId])
  @@index([ingredientProductId])
}

/// Tracking record for lost, spoiled, damaged, or expired product write-offs
model productWaste {
  id              Int         @id @default(autoincrement())
  productId       Int
  facilityId      Int?
  sectionId       Int?
  quantity        Decimal     @db.Decimal(20, 4)
  unitCost        Decimal     @default(0) @db.Decimal(20, 4)
  totalCost       Decimal     @default(0) @db.Decimal(20, 4)
  reason          wasteReason
  notes           String?     @db.Text
  wasteDate       DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime?   @updatedAt
  deletedAt       DateTime?
  createdBy       String
  updatedBy       String?

  product         product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  facility        facility?        @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  section         facilitySection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  wasteCreatedBy  user             @relation("productWasteCreatedBy", fields: [createdBy], references: [id])
  wasteUpdatedBy  user?            @relation("productWasteUpdatedBy", fields: [updatedBy], references: [id])

  @@index([productId])
  @@index([facilityId])
  @@index([sectionId])
  @@index([reason])
  @@index([wasteDate])
}
