enum vehicleType {
  truck
  pickup
  van
  motorcycle
  car
  heavyVehicle
}

enum vehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  DECOMMISSIONED
}

enum driverStatus {
  AVAILABLE
  ON_TRIP
  ON_LEAVE
  INACTIVE
}

enum tripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model vehicle {
  id               Int            @id @default(autoincrement())
  plateNumber      String         @unique @db.VarChar(20)
  model            String         @db.VarChar(100)
  brand            String         @db.VarChar(50)
  type             vehicleType    @default(truck)
  year             Int?
  capacity         Decimal?       @db.Decimal(10, 2)
  status           vehicleStatus  @default(AVAILABLE)
  fuelType         String?        @db.VarChar(30)
  currentOdometer  Decimal        @default(0) @db.Decimal(12, 2)
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime?      @updatedAt
  deletedAt        DateTime?
  createdBy        String
  updatedBy        String?
  vehicleCreatedBy user           @relation("vehicleCreatedBy", fields: [createdBy], references: [id])
  vehicleUpdatedBy user?          @relation("vehicleUpdatedBy", fields: [updatedBy], references: [id])
  trips            trip[]         @relation("vehicleTrips")
  fuelLogs         fuelLog[]      @relation("vehicleFuelLogs")

  @@index([status])
  @@index([deletedAt])
}

model driver {
  id               Int            @id @default(autoincrement())
  profileId        Int?
  employeeId       Int?
  name             String         @db.VarChar(100)
  licenseNumber    String         @unique @db.VarChar(50)
  licenseType      String         @db.VarChar(20)
  licenseExpired   DateTime?
  phoneNumber      String?        @db.VarChar(30)
  status           driverStatus   @default(AVAILABLE)
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime?      @updatedAt
  deletedAt        DateTime?
  createdBy        String
  updatedBy        String?
  driverCreatedBy  user           @relation("driverCreatedBy", fields: [createdBy], references: [id])
  driverUpdatedBy  user?          @relation("driverUpdatedBy", fields: [updatedBy], references: [id])
  trips            trip[]         @relation("driverTrips")

  @@index([status])
  @@index([profileId])
  @@index([employeeId])
  @@index([deletedAt])
}

model trip {
  id               Int            @id @default(autoincrement())
  tripNumber       String         @unique @db.VarChar(50)
  vehicleId        Int
  driverId         Int
  origin           String         @db.VarChar(150)
  destination      String         @db.VarChar(150)
  departureTime    DateTime?
  arrivalTime      DateTime?
  startOdometer    Decimal?       @db.Decimal(12, 2)
  endOdometer      Decimal?       @db.Decimal(12, 2)
  distance         Decimal?       @db.Decimal(12, 2)
  status           tripStatus     @default(SCHEDULED)
  cargoDescription String?        @db.Text
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime?      @updatedAt
  deletedAt        DateTime?
  createdBy        String
  updatedBy        String?
  vehicle          vehicle        @relation("vehicleTrips", fields: [vehicleId], references: [id])
  driver           driver         @relation("driverTrips", fields: [driverId], references: [id])
  tripCreatedBy    user           @relation("tripCreatedBy", fields: [createdBy], references: [id])
  tripUpdatedBy    user?          @relation("tripUpdatedBy", fields: [updatedBy], references: [id])
  fuelLogs         fuelLog[]      @relation("tripFuelLogs")

  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  @@index([deletedAt])
}

model fuelLog {
  id               Int            @id @default(autoincrement())
  vehicleId        Int
  tripId           Int?
  date             DateTime       @default(now())
  odometer         Decimal?       @db.Decimal(12, 2)
  liters           Decimal        @db.Decimal(10, 2)
  pricePerLiter    Decimal        @db.Decimal(20, 4)
  totalCost        Decimal        @db.Decimal(20, 4)
  gasStation       String?        @db.VarChar(100)
  receiptNumber    String?        @db.VarChar(50)
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime?      @updatedAt
  deletedAt        DateTime?
  createdBy        String
  updatedBy        String?
  vehicle          vehicle        @relation("vehicleFuelLogs", fields: [vehicleId], references: [id])
  trip             trip?          @relation("tripFuelLogs", fields: [tripId], references: [id])
  fuelLogCreatedBy user           @relation("fuelLogCreatedBy", fields: [createdBy], references: [id])
  fuelLogUpdatedBy user?          @relation("fuelLogUpdatedBy", fields: [updatedBy], references: [id])

  @@index([vehicleId])
  @@index([tripId])
  @@index([date])
  @@index([deletedAt])
}
